{ echo "=== 1. CONTEXT UTILIZATOR & GRUPURI ==="; id; groups; echo -e "\n=== 2. KERNEL, OS & VERSIUNE SUDO ==="; uname -a; cat /proc/version; cat /etc/*release 2>/dev/null; sudo -V 2>/dev/null | head -n 5; echo -e "\n=== 3. REȚEA, RUTE, ARP & CONEXIUNI ==="; ip -br a; ip route; arp -e 2>/dev/null || ip neigh; cat /etc/hosts; ss -tulnp; cat /proc/net/tcp 2>/dev/null | head -n 20; echo -e "\n=== 4. FSTAB, SISTEME DE FIȘIERE & PERMISIUNI /TMP ==="; cat /etc/fstab 2>/dev/null; mount | grep -E '^/dev'; ls -ld /tmp /var/tmp /dev/shm; echo -e "\n=== 5. VERIFICARE DIRECTOARE DIN PATH (WRITABLE) ==="; echo "PATH curent: $PATH"; IFS=:; for d in $PATH; do [ -d "$d" ] && find "$d" -maxdepth 0 -perm -0002 -ls 2>/dev/null; done; unset IFS; echo -e "\n=== 6. AUDIT PERMISIUNI FIȘIERE CRITICE & ISTORIC PAROLE ==="; stat -c "%a %U:%G %n" /etc/passwd /etc/shadow /etc/sudoers /etc/security/opasswd 2>/dev/null; find /etc -writable -type f 2>/dev/null; echo -e "\n=== 7. AUDIT PERMISIUNI FIȘIERE DE CONFIGURARE & LOG-URI ==="; ls -la /home/*/.netrc /home/*/.docker/config.json /home/*/.pgpass /home/*/.bash_history 2>/dev/null; ls -ld /var/log/* 2>/dev/null; echo -e "\n=== 8. BINARE SUID & SGID ==="; find / -perm -4000 -o -perm -2000 -type f 2>/dev/null | grep -vE '^(/snap|/proc|/sys)'; echo -e "\n=== 9. LINUX CAPABILITIES (GETCAP) ==="; getcap -r / 2>/dev/null; echo -e "\n=== 10. CRON JOBS, SYSTEMD TIMERS & UNITĂȚI MODIFICABILE ==="; cat /etc/crontab 2>/dev/null; ls -la /etc/cron* /var/spool/cron/crontabs 2>/dev/null; find /etc/systemd/system /lib/systemd/system /etc/init.d -writable 2>/dev/null; echo -e "\n=== 11. PARTAJĂRI NFS & SERVICII DE PRINTARE (CUPS) ==="; cat /etc/exports 2>/dev/null; lpstat -p 2>/dev/null; } | less
